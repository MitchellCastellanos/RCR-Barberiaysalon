rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public site config: anyone can read; only authenticated admin can write.
    match /config/site {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Products: public read (storefront + QR landing page), admin-only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Inventory movement log and cash-register sales: admin-only, never
    // exposed to the public site.
    match /inventoryMovements/{movementId} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    // Lock everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
